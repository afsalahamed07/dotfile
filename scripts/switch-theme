#!/usr/bin/env python3
from __future__ import annotations

import json
import re
import shutil
import sys
from dataclasses import dataclass
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]


@dataclass(frozen=True)
class Theme:
    name: str
    kitty: str
    ghostty: str
    btop: str
    opencode: str
    zed_dark: str
    tmux: str
    gitui: str


THEMES = {
    "hubbamax": Theme(
        name="hubbamax",
        kitty="kitty/hubbamax.conf",
        ghostty="hubbamax.ghostty",
        btop="hubbamax",
        opencode="hubbamax",
        zed_dark="Hubbamax",
        tmux="tmux/themes/hubbamax.conf",
        gitui="gitui/themes/hubbamax.ron",
    ),
    "rose-pine": Theme(
        name="rose-pine",
        kitty="kitty/rose-pine.conf",
        ghostty="Rose Pine",
        btop="rose-pine",
        opencode="rose-pine",
        zed_dark="Rosé Pine",
        tmux="tmux/themes/rose-pine.conf",
        gitui="gitui/themes/rose-pine.ron",
    ),
}

def read_current() -> str | None:
    path = ROOT / "theme/current"
    if not path.exists():
        return None
    return path.read_text(encoding="utf-8").strip() or None


def write_current(theme: Theme) -> None:
    current = ROOT / "theme/current"
    current.parent.mkdir(parents=True, exist_ok=True)
    current.write_text(theme.name + "\n", encoding="utf-8")


def replace_text(path: Path, pattern: str, replacement: str) -> None:
    text = path.read_text(encoding="utf-8")
    new_text, count = re.subn(pattern, replacement, text, flags=re.MULTILINE)
    if count == 0:
        raise RuntimeError(f"No match in {path.relative_to(ROOT)} for {pattern!r}")
    path.write_text(new_text, encoding="utf-8")


def copy_file(src: str | Path, dst: str | Path) -> None:
    source = ROOT / src
    target = ROOT / dst
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, target)


def apply_kitty(theme: Theme) -> None:
    copy_file(theme.kitty, "kitty/current-theme.conf")


def apply_ghostty(theme: Theme) -> None:
    replace_text(
        ROOT / "ghostty/config",
        r"^\s*theme\s*=.*$",
        f"theme = {theme.ghostty}",
    )


def apply_btop(theme: Theme) -> None:
    replace_text(
        ROOT / "btop/btop.conf",
        r'^[ \t]*color_theme[ \t]*=[ \t]*".*"[ \t]*$',
        f'color_theme = "{theme.btop}"',
    )


def apply_opencode(theme: Theme) -> None:
    path = ROOT / "opencode/tui.json"
    data = json.loads(path.read_text(encoding="utf-8"))
    data["theme"] = theme.opencode
    path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


def apply_zed(theme: Theme) -> None:
    path = ROOT / "zed/settings.json"
    text = path.read_text(encoding="utf-8")
    pattern = r'("theme"\s*:\s*\{[^}]*"dark"\s*:\s*)"[^"]+"'
    replacement = rf'\1"{theme.zed_dark}"'
    new_text, count = re.subn(pattern, replacement, text, count=1, flags=re.DOTALL)
    if count == 0:
        raise RuntimeError("No theme.dark entry found in zed/settings.json")
    path.write_text(new_text, encoding="utf-8")


def apply_tmux(theme: Theme) -> None:
    copy_file(theme.tmux, "tmux/themes/current.conf")


def apply_gitui(theme: Theme) -> None:
    copy_file(theme.gitui, "gitui/theme.ron")


def apply_theme(theme: Theme) -> None:
    write_current(theme)
    apply_kitty(theme)
    apply_ghostty(theme)
    apply_btop(theme)
    apply_opencode(theme)
    apply_zed(theme)
    apply_tmux(theme)
    apply_gitui(theme)


def usage() -> str:
    names = ", ".join(sorted(THEMES))
    return f"Usage: {Path(sys.argv[0]).name} <{names}|current|list>"


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(usage(), file=sys.stderr)
        return 2

    command = argv[1]

    if command == "list":
        for name in sorted(THEMES):
            print(name)
        return 0

    if command == "current":
        current = read_current()
        if current is None:
            print("No current theme is configured", file=sys.stderr)
            return 1
        if current not in THEMES:
            print(f"Configured theme does not exist: {current}", file=sys.stderr)
            return 1
        print(current)
        return 0

    theme = THEMES.get(command)
    if theme is None:
        print(f"Unknown theme: {argv[1]}", file=sys.stderr)
        print(usage(), file=sys.stderr)
        return 2

    apply_theme(theme)
    print(f"Switched theme to {theme.name}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
