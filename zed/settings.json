{
  // ============================================================
  //  APPEARANCE
  // ============================================================
  "prettier": {
    "allowed": true
  },
  "which_key": {
    "enabled": true
  },
  "cli_default_open_behavior": "existing_window",
  "proxy": "",
  "theme": {
    "mode": "dark",
    "light": "Hubbamax",
    "dark": "Hubbamax",
  },
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },

  // Transparent Background
  "experimental.theme_overrides": {
    "background.appearance": "blurred",
  },

  // ============================================================
  //  FONTS
  // ============================================================
  "ui_font_size": 16,
  "buffer_font_family": "Maple Mono NF",
  "buffer_font_size": 17,
  "buffer_line_height": {
    "custom": 1.7,
  },

  // ============================================================
  //  EDITOR BEHAVIOR
  // ============================================================
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 8,
  "cursor_blink": true,
  "format_on_save": "off",
  "wrap_guides": [80, 120],
  "scrollbar": {
    "show": "never",
  },

  // ============================================================
  //  PANELS / DOCKS
  // ============================================================
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },

  // ============================================================
  //  LANGUAGES
  // ============================================================
  "languages": {
    "HTML": {
      "show_edit_predictions": true,
    },
  },

  // ============================================================
  //  REMOTE / SSH
  // ============================================================
  "ssh_connections": [
    {
      "host": "github.com",
      "projects": [],
    },
  ],
}
