{
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ssh_connections": [
    {
      "host": "github.com",
      "projects": [],
    },
  ],
  "languages": {
    "HTML": {
      "show_edit_predictions": true,
    },
  },
  "show_edit_predictions": false,
  "base_keymap": "Emacs",
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_family": "MonoLisa",
  "buffer_font_size": 18,
  "buffer_line_height": {
    "custom": 1.6,
  },
  "format_on_save": "off",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Ayu Dark",
  },

  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 8,
  "cursor_blink": true,
  "scrollbar": {
    "show": "never",
  },
  "project_panel": {
    "dock": "right",
  },

  "wrap_guides": [80, 120],
}
